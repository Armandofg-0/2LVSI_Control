      Parameter {
        Variable      "OutputFcn"
        Value         "float ia = (float)InputSignal(0,0);\n"
"float ib = (float)InputSignal(0,1);\n"
"float ic = (float)InputSignal(0,2);\n"
"\n"
"/* Clarke: abc -> ab (wideband, instantaneous). */\n"
"Transform_ABC_to_Clarke(&i_clarke, ia, ib, ic);\n"
"\n"
"OutputSignal(0,0) = i_clarke.alpha;   /* -> PCI i_meas_a */\n"
"OutputSignal(0,1) = i_clarke.beta;    /* -> PCI i_meas_b */\n"
"\n"
"/* debug tap, re-enable + add a port if needed:\n"
"OutputSignal(0,2) = i_clarke.zero;    // zero-sequence current\n"
"*/\n"
        Show          off
