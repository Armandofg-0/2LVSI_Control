"er.c\"\n"
"\n"
"STARTUP_SEQ seq;\n"
"#define TS ParamRealData(0,0)            /* global Ts */\n"
"\n"
"/* tuning knobs, kept local on purpose */\n"
"const double T_MIN_SYNC = 0.100;         /* min sync time before connect [s] "
"*/\n"
"const double T_RAMP     = 0.100;         /* current soft-start ramp [s]      "
"*/\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "STARTUP_SEQ_init(&seq, TS, T_MIN_SYNC, T_RAMP);\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "int locked = (int)(InputSignal(0,0) + 0.5);\n"
"STARTUP_SEQ_step(&seq, locked);\n"
"OutputSignal(0,0) = seq.gate_enable;     /* -> ANDed with the 6 gates */\n"
"OutputSignal(0,1) = seq.p_scale;         /* -> multiplies i_ref       */\n"
        Show          off
      }
