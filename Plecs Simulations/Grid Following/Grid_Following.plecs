      Parameter {
        Variable      "Declarations"
        Value         "#include \"../../Code/Reference_Gen/reference_gen.c\"\n"
"#include <stdio.h>\n"
"REFERENCE_GEN refgen;\n"
"\n"
"/* globals from the PLECS mask: [P_ref Q_ref k_weight ipc_wideband Ts] */\n"
"#define P_ref    ParamRealData(0,0)   /* active power setpoint   [W]   (globa"
"l P_ref)   */\n"
"#define Q_ref    ParamRealData(0,1)   /* reactive power setpoint [VAr] (globa"
"l Q_ref)   */\n"
"#define k_weight ParamRealData(0,2)   /* CBC/IPC blend [0..1], see Section 4."
"4 (global k_weight) */\n"
"#define ipc_wideband ((int)ParamRealData(0,3))  /* 0=IPC fund | 1=IPC wb */\n"
"#define TS ParamRealData(0,4)          /* control period [s] (global Ts) */\n"
"\n"
"/* P/Q-ref step test: holds each level T_STEP s (0.6 s settling + margin).\n"
"   Toggle USE_P_STEP_TEST off to fall back to the plain P_ref/Q_ref mask valu"
"es. */\n"
"const int    USE_P_STEP_TEST = 1;\n"
"const double P_STEPS[] = {3000.0, 6000.0, 9000.0, 12000.0};   /* [W] */\n"
"const double Q_STEPS[] = {0.0, 1000.0, -1000.0, 2000.0};      /* [VAr] */\n"
"const int    N_STEPS = 4;\n"
"const double T_STEP  = 1.0;                                    /* [s] */\n"
"static double t_elapsed = 0.0;                                  /* [s] */\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "REFERENCE_GEN_init(&refgen);\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "double v_alpha_pos = InputSignal(0,0);\n"
"double v_beta_pos  = InputSignal(0,1);\n"
"double v_alpha_neg = InputSignal(0,2);\n"
"double v_beta_neg  = InputSignal(0,3);\n"
"double v_alpha_wb  = InputSignal(0,4);   /* raw Clarke a (PLL port 6) */\n"
"double v_beta_wb   = InputSignal(0,5);   /* raw Clarke b (PLL port 7) */\n"
"\n"
"t_elapsed += TS;\n"
"\n"
"/* one-shot-per-run diagnostic: proves what k_weight/P_ref/Q_ref/ipc_wideband"
"\n"
"   the compiled mask actually handed the C code on THIS simulate() call.\n"
"   Remove once the k-sweep bug is confirmed fixed. */\n"
"if (t_elapsed <= TS + 1e-9) {\n"
"    printf(\"[diag] t_elapsed=%.6f k_weight=%.4f P_ref=%.1f Q_ref=%.1f ipc_wi"
"deband=%d\\n\",\n"
"           t_elapsed, k_weight, P_ref, Q_ref, ipc_wideband);\n"
"}\n"
"double P_ref_eff = P_ref;\n"
"double Q_ref_eff = Q_ref;\n"
"if (USE_P_STEP_TEST) {\n"
"    int step_idx = (int)(t_elapsed / T_STEP);\n"
"    if (step_idx >= N_STEPS) step_idx = N_STEPS - 1;\n"
"    P_ref_eff = P_STEPS[step_idx];\n"
"    Q_ref_eff = Q_STEPS[step_idx];\n"
"}\n"
"\n"
"REFERENCE_GEN_step(&refgen,\n"
"                   v_alpha_pos, v_beta_pos,\n"
"                   v_alpha_neg, v_beta_neg,\n"
"                   v_alpha_wb,  v_beta_wb,\n"
"                   P_ref_eff, Q_ref_eff, k_weight, ipc_wideband);\n"
"\n"
"OutputSignal(0,0) = refgen.i_alpha_ref;\n"
"OutputSignal(0,1) = refgen.i_beta_ref;\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
