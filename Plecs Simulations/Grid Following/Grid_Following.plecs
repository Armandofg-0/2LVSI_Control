    Component {
      Type          CScript
      Name          "MSOGI-PLL"
      Show          on
      Position      [620, 800]
      Direction     up
      Flipped       off
      LabelPosition south
      Parameter {
        Variable      "DialogGeometry"
        Value         "[0 22 1920 1017]"
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "3"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "9"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "10"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "[Ts, 0]"
        Show          off
      }
      Parameter {
        Variable      "TerminalBasedSampleTimes"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         "[f Ts]\n"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#include \"../../Code/DSOGI_MSOGI/msogi_pll.c\"\n"
"\n"
"/* globals from the PLECS mask: [f Ts] */\n"
"#define F_NOM ParamRealData(0,0)   /* grid nominal frequency [Hz] (global f) "
" */\n"
"#define TS    ParamRealData(0,1)   /* control period [s]          (global Ts)"
" */\n"
"\n"
"MSOGI_PLL pll;\n"
"\n"
"/* harmonic bank: fundamental + 5th + 7th */\n"
"#define NUM_H 3\n"
"double harmonics_array[NUM_H] = {1.0, 5.0, 7.0};\n"
"\n"
"/* tuning knobs, kept local on purpose */\n"
"const double k_sogi   = 0.707;   /* SOGI selectivity */\n"
"const double E_max    = 200.0;   /* MSOGI adaptive-gain clamp */\n"
"const float  Kp_pll   = 7.7f;    /* loop PI proportional */\n"
"const float  Ki_pll   = 15.0f;   /* loop PI integral (angle anchor) */\n"
"const float  pi_lim   = 100.0f;  /* PI output clamp [rad/s] */\n"
"const float  lpf_w_fc = 50.0f;   /* omega-output LPF cutoff [Hz] */\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "MSOGI_PLL_init(&pll,\n"
"               TS,          /* control period      (global Ts) */\n"
"               F_NOM,       /* nominal grid freq   (global f)  */\n"
"               k_sogi,\n"
"               E_max,\n"
"               Kp_pll,\n"
"               Ki_pll,\n"
"               pi_lim,\n"
"               lpf_w_fc,\n"
"               NUM_H,\n"
"               harmonics_array);\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "double v_a = InputSignal(0,0);\n"
"double v_b = InputSignal(0,1);\n"
"double v_c = InputSignal(0,2);\n"
"\n"
"MSOGI_PLL_step(&pll, v_a, v_b, v_c);\n"
"\n"
"OutputSignal(0,0) = pll.theta;           /* -> Current_Measurement (theta) */"
"\n"
"OutputSignal(0,1) = pll.omega_out;       /* -> Current_Measurement, PCI (omeg"
"a) */\n"
"OutputSignal(0,2) = pll.v_alpha_pos;     /* -> Reference_Gen (V+ a) */\n"
"OutputSignal(0,3) = pll.v_beta_pos;      /* -> Reference_Gen (V+ b) */\n"
"OutputSignal(0,4) = pll.seq.v_alpha_neg; /* -> Reference_Gen (V- a) */\n"
"OutputSignal(0,5) = pll.seq.v_beta_neg;  /* -> Reference_Gen (V- b) */\n"
"double vrec_a = 0.0, vrec_b = 0.0;\n"
"for (int i = 0; i < pll.msogi.num_harmonics; ++i) {\n"
"    vrec_a += pll.msogi.dsogi_h[i].v_alpha;\n"
"    vrec_b += pll.msogi.dsogi_h[i].v_beta;\n"
"}\n"
"OutputSignal(0,6) = vrec_a;   /* clean reconstruction instead of raw Clarke *"
"/\n"
"OutputSignal(0,7) = vrec_b;\n"
"\n"
"OutputSignal(0,8) = pll.locked;          /* -> Startup_Sequencer */\n"
"\n"
"/* debug taps, re-enable + add output ports if needed:\n"
"OutputSignal(0,8)  = pll.v_zero;                    // Clarke zero-seq\n"
"OutputSignal(0,9)  = pll.v_d;                       // Park d (pos-seq)\n"
"OutputSignal(0,10) = pll.v_q;                       // Park q (pos-seq)\n"
"OutputSignal(0,11) = pll.msogi.dsogi_h[0].v_alpha;  // fundamental a (no harm"
"onics)\n"
"OutputSignal(0,12) = pll.msogi.dsogi_h[0].v_beta;   // fundamental b\n"
"*/\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
