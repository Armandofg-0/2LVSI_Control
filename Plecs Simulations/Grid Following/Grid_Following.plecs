    Component {
      Type          CScript
      Name          "PCI"
      Show          on
      Position      [1280, 935]
      Direction     up
      Flipped       off
      LabelPosition south
      Parameter {
        Variable      "DialogGeometry"
        Value         "[1 31 958 1008]"
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "7"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "10"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "[Ts, 0]"
        Show          off
      }
      Parameter {
        Variable      "TerminalBasedSampleTimes"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         "[Vdc Ts]"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#include \"../../Code/PCI/pci.c\"\n"
"#include \"../../Code/Low_Pass_Filter/low_pass_filter_1degree.c\"\n"
"\n"
"PCI_CTRL pci;\n"
"PCI_CTRL pci_next;\n"
"LP_FILTER_1DEGREE imeas_a_filt;\n"
"LP_FILTER_1DEGREE imeas_b_filt;\n"
"\n"
"/* globals from the PLECS mask: [Vdc Ts] */\n"
"#define VDC ParamRealData(0,0)   /* DC-link voltage [V]   (global Vdc) */\n"
"#define TS  ParamRealData(0,1)   /* control period [s]    (global Ts)  */\n"
"\n"
"/* tuning knobs, kept local on purpose */\n"
"const double Kp_pci      = 75.0;    /* proportional gain */\n"
"const double Ki_fund     = 628.318; /* resonant gain, fundamental +-1 */\n"
"const double Ki_harm     = 2000.0;  /* resonant gain, harmonics -5/+7 */\n"
"const double Vlim_margin = 0.99;    /* fraction of the SVM linear ceiling Vdc"
"/sqrt3 */\n"
"const double Imeas_lpf_fc = 5000.0; /* anti-alias cutoff [Hz], unused for now"
": PCI reads i_meas raw, see Output */\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "/* Per-axis saturation tracks the SVM linear ceiling (V"
"dc/sqrt3). */\n"
"const double INV_SQRT3 = 0.57735026918962576451;\n"
"double Vlim_pci = VDC * INV_SQRT3 * Vlim_margin;   /* ~ 400 V at Vdc=700 */\n"
"\n"
"INIT_LP_FILTER_1D(&imeas_a_filt, (float)Imeas_lpf_fc, (float)TS);\n"
"INIT_LP_FILTER_1D(&imeas_b_filt, (float)Imeas_lpf_fc, (float)TS);\n"
"\n"
"PCI_init(&pci, TS, Kp_pci, Vlim_pci);\n"
"PCI_add_term(&pci, +1.0, Ki_fund);\n"
"PCI_add_term(&pci, -1.0, Ki_fund);\n"
"PCI_add_term(&pci, +3.0, Ki_harm);\n"
"PCI_add_term(&pci, -3.0, Ki_harm);\n"
"PCI_add_term(&pci, +5.0, Ki_harm);\n"
"PCI_add_term(&pci, -5.0, Ki_harm);\n"
"PCI_add_term(&pci, +7.0, Ki_harm);\n"
"PCI_add_term(&pci, -7.0, Ki_harm);\n"
"PCI_add_term(&pci, +9.0, Ki_harm);\n"
"PCI_add_term(&pci, -9.0, Ki_harm);\n"
"PCI_add_term(&pci, +11.0, Ki_harm);\n"
"PCI_add_term(&pci, -11.0, Ki_harm);\n"
"PCI_add_term(&pci, +13.0, Ki_harm);\n"
"PCI_add_term(&pci, -13.0, Ki_harm);\n"
"PCI_add_term(&pci, +15.0, Ki_harm);\n"
"PCI_add_term(&pci, -15.0, Ki_harm);\n"
"PCI_add_term(&pci, +17.0, Ki_harm);\n"
"PCI_add_term(&pci, -17.0, Ki_harm);\n"
"PCI_add_term(&pci, +19.0, Ki_harm);\n"
"PCI_add_term(&pci, -19.0, Ki_harm);\n"
"PCI_add_term(&pci, +21.0, Ki_harm);\n"
"PCI_add_term(&pci, -21.0, Ki_harm);\n"
"PCI_add_term(&pci, +23.0, Ki_harm);\n"
"PCI_add_term(&pci, -23.0, Ki_harm);\n"
"PCI_add_term(&pci, +25.0, Ki_harm);\n"
"PCI_add_term(&pci, -25.0, Ki_harm);\n"
"PCI_set_delay_comp(&pci, 1.5);\n"
"/* tiny leak so the resonators don't lead the tracked current by one sample *"
"/\n"
"PCI_set_leak(&pci, 0.9999999);\n"
"pci_next = pci;\n"
"\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "double i_ref_a      = InputSignal(0,0);   /* from Refer"
"ence_Gen              */\n"
"double i_ref_b      = InputSignal(0,1);\n"
"double i_meas_a_raw = InputSignal(0,2);   /* from Current_Measurement (raw ab"
") */\n"
"double i_meas_b_raw = InputSignal(0,3);\n"
"double omega        = InputSignal(0,4);   /* from MSOGI_PLL                  "
"*/\n"
"double vg_a         = InputSignal(0,5);   /* feedforward: raw grid voltage ab"
" */\n"
"double vg_b         = InputSignal(0,6);\n"
"\n"
"/* i_meas goes into the PCI raw -- filtering it here would lag the\n"
"   feedback and cost more ripple than the switching noise it removes */\n"
"double i_meas_a = i_meas_a_raw;\n"
"double i_meas_b = i_meas_b_raw;\n"
"(void)imeas_a_filt; (void)imeas_b_filt;\n"
"\n"
"/* copy + step (keep Output pure; state commits in Update) */\n"
"pci_next = pci;\n"
"PCI_step(&pci_next,\n"
"         i_ref_a, i_ref_b,\n"
"         i_meas_a, i_meas_b,\n"
"         omega, vg_a, vg_b);\n"
"\n"
"OutputSignal(0,0) = pci_next.v_alpha;   /* -> SVM V_alpha */\n"
"OutputSignal(0,1) = pci_next.v_beta;    /* -> SVM V_beta  */\n"
"\n"
"/* debug tap, re-enable + add a port if needed:\n"
"OutputSignal(0,2) = sqrt(pci_next.v_alpha*pci_next.v_alpha\n"
"                       + pci_next.v_beta *pci_next.v_beta);  // |V| vs Vdc/sq"
"rt3\n"
"*/\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "pci = pci_next;   /* commit: x[k] -> x[k+1] */\n"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
