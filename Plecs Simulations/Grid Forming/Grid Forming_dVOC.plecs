Plecs {
  Name          "dVOC_OscillatorCore_Test"
  Version       "5.0"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "8.0"
  Timeout       ""
  Solver        "auto"
  MaxStep       "5e-5"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-4"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "phi = pi/2; ki = 30;\n%% Grid Scenery\nXR = 10;\nSCR"
" = 3; \n\n%% Grid.\nVbaseRMS = 110e3;\nVbasePeak = VbaseRMS*sqrt(2);\nVbaseFN"
"Peak = VbaseRMS*sqrt(2)/(sqrt(3));\nfg = 50;\nwg = 2*pi*50;\n\n%% Filter. \nL"
"F1 = 53.33e-3;\nLF2 = 5.33e-3;\nCF = 1.2015e-6;\nfr = sqrt((LF1+LF2)/(CF*LF1*"
"LF2))/(2*pi);\nRd = 13; % para minimizar el THD. \nRi = 0.5;\n\n%% Inverter. "
"\nVdc = 500e3;\nfsw = 12.5e3;\nSnom = 100e6; \nIbaseRMS = Snom/(sqrt(3)*Vbase"
"RMS); \nIbasePeak = IbaseRMS*sqrt(2); \nZbase = VbaseRMS*VbaseRMS/Snom; \n\n%"
"% Grid Impedance.\nRg = VbaseRMS^2 / (SCR * Snom * sqrt(1+XR^2));\nLg = XR*Rg"
"/(2*pi*fg);\n\n%% Primary Loop. \nfp = 10;\n\n%% Voltage Profile Management. "
"\n\n\n%% ===== dVOC nucleo (por unidad) =====\n\nxi = 100;\n\nVref = 1;\n\nkv"
" = 1;\n\nCosc = 1;\n\nLosc = 1/wg^2;\n\neps = sqrt(Losc/Cosc);\n\nvc0 = 1e-3;"
"\n\n%% ===== Interfaz fisica =====\n\nKv_out = VbaseFNPeak/sqrt(2);\n\nInorm "
"= IbasePeak;\n\nKgamma = 2/3;\n\n%% ===== Cargas =====\n\nPload1 = 30e6;\n\nR"
"load1 = VbaseRMS^2/Pload1;\n\nPload2 = 20e6;\n\nRload2 = VbaseRMS^2/Pload2;\n"
"\n%% ===== Cronograma de escenarios (s) =====\n\ngrid_ini = 0;\n\nt_en = 0;\n"
"\nt_loadon = 0.6; t_loadoff = 1.2;\n\nt_gridon = 2.0; t_gridoff = 7.2;\n\nPst"
"ar_cmd = 30e6; tP_step = 2.8;\n\nQstar_cmd = 10e6; tQ_step = 3.8; tQ_off = 6."
"8;\n\nt_sag = 4.6; dur_sag = 0.4; V_sag = 0.8;\n\nt_freq = 5.6; df_grid = -0."
"2;\n\nt_phase = 6.2; dur_phase = 0.4; ph_jump = 10*pi/180;\n\n%% ===== Pre-si"
"ncronizacion =====\npresync_en = 1;\nt_presync = 1.4;\nksync_gain = 10;\nKsyn"
"c = ksync_gain*Inorm/VbaseFNPeak;\n\n%% ===== Resistencia virtual (amortiguam"
"iento) =====\nRv_damp = 0.05*Zbase;\n\n%% ===== Lazo integral Q->V (toggle) ="
"====\nq_en = 1;\nKqv = 1e-6;\n\n"
  InitialState  "1"
  SystemState   ""
  JacobianComputation "2"
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
  CodeGenFloatingPointFormat "2"
  CodeGenAbsTimeUsageMsg "3"
  CodeGenBaseName ""
  CodeGenOutputDir ""
  CodeGenExtraOpts ""
  CodeGenTarget "Generic"
  CodeGenTargetSettings ""
