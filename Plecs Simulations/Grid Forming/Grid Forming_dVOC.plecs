              }
              Parameter {
                Variable      "Declarations"
                Value         base64 "Ly8gRXN0YWRvIHF1ZSBpbmRpY2EgZWwgw61uZGlj"
"ZSBlbiBlbCBxdWUgZXN0YW1vcwojZGVmaW5lIGN1cnJfaWR4IERpc2NTdGF0ZSgwKQoKLy8gYnVmZ"
"mVyIGludGVybm8gcGFyYSBlbCBwcsOzeGltbyBlc3RhZG8gKHNlIHB1ZWRlIGVzY3JpYmlyIGVuIE"
"91dHB1dCkKc3RhdGljIGludCBuZXh0X2lkeDsKCgovLyBQYXLDoW1ldHJvcwojZGVmaW5lIE4gICA"
"gICBQYXJhbVJlYWxEYXRhKDAsMCkgICAgLy8gc3RlcHNfTiAoZXNjYWxhcikKI2RlZmluZSBUSShp"
"KSAgUGFyYW1SZWFsRGF0YSgxLChpKSkgIC8vIHBhc29zOiBpbmljaW8KI2RlZmluZSBURihpKSAgU"
"GFyYW1SZWFsRGF0YSgyLChpKSkgIC8vIHBhc29zOiBmaW4KI2RlZmluZSBBTVAoaSkgUGFyYW1SZW"
"FsRGF0YSgzLChpKSkgIC8vIHBhc29zOiBhbXBsaXR1ZCAoc2Ugc3VtYSBhIGxhIHNlw7FhbCBiYXN"
"lKQojZGVmaW5lIE1PREUgICBQYXJhbVJlYWxEYXRhKDQsMCkgICAgLy8gMD1zdW1hLCAxPW11bHRp"
"cGxpY2E="
                Show          off
              }
              Parameter {
                Variable      "StartFcn"
                Value         "// Sin paso activo al iniciar\n"
"curr_idx = -1;\n"
"next_idx = -1;"
                Show          off
              }
              Parameter {
                Variable      "OutputFcn"
                Value         "const double in = Input(0);\n"
"const double t  = CurrentTime;\n"
"const double en = Input(1);\n"
"const int n = N;\n"
"\n"
"// Sin pasos definidos o deshabilitado: salida directa\n"
"if (n <= 0 || en <= 0.0) {\n"
"    Output(0) = in;\n"
"    next_idx = curr_idx;\n"
"    return;\n"
"}\n"
"\n"
"// Tiempo de rampa en los bordes: convierte el escalon del disturbio en una r"
"ampa\n"
"// lineal (suaviza el transitorio). Editable aqui.\n"
"const double tr = 2e-3;\n"
"\n"
"// Busqueda del paso activo mas reciente con TI ascendente\n"
"int best = -1;\n"
"int i = curr_idx;\n"
"if (i < 0) i = 0;\n"
"if (i > 0 && t < TI(i)) i--;\n"
"for (; i < n; ++i) {\n"
"   const double ti = TI(i);\n"
"   if (ti > t) break;\n"
"   const double tf = TF(i);\n"
"   if ((t >= ti) && (t < tf)) best = i;\n"
"}\n"
"\n"
"// Salida: rampa lineal en los bordes en lugar de escalon instantaneo\n"
"double y = in;\n"
"if (best >= 0) {\n"
"    const double ti = TI(best);\n"
"    const double tf = TF(best);\n"
"    double ramp = 1.0;\n"
"    if (tr > 0.0) {\n"
"        double up = (t - ti)/tr;\n"
"        double dn = (tf - t)/tr;\n"
"        double s = (up < dn) ? up : dn;\n"
"        if (s > 1.0) s = 1.0;\n"
"        if (s < 0.0) s = 0.0;\n"
"        ramp = s;\n"
"    }\n"
"    if (MODE == 1) {\n"
"        y = in * (1.0 + (AMP(best) - 1.0)*ramp);\n"
"    } else {\n"
"        y = in + AMP(best)*ramp;\n"
"    }\n"
"}\n"
"Output(0) = y;\n"
"\n"
"// Preparar el proximo estado (NO escribir DiscState aqui)\n"
"next_idx = (best >= 0) ? best : (i - 1);\n"
"if (next_idx < -1) next_idx = -1;"
                Show          off
              }
              Parameter {
                Variable      "UpdateFcn"
                Value         "curr_idx = next_idx;"
                Show          off
              }
              Parameter {
                Variable      "DerivativeFcn"
                Value         ""
                Show          off
              }
              Parameter {
                Variable      "TerminateFcn"
                Value         ""
                Show          off
              }
              Parameter {
