Plecs {
  Name          "Grid Forming_dVOC"
  Version       "5.0"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "T_sim"
  Timeout       ""
  Solver        "auto"
  MaxStep       "5e-5"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-4"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "%% ---- SCENARIOS ----------------------------------"
"-----------------------\n% Set exactly one of these to 1.\nenable_1 = 0;   % "
"black start\nenable_2 = 0;   % resynchronization to the grid\nenable_3 = 0;  "
" % P/Q dispatch tracking\nenable_4 = 1;   % grid disturbance ride-through\n\n"
"% Scenario 4 options\nsag_en    = 1;     % voltage sag\nfreq_en   = 1;     % "
"frequency step\nphase_en  = 0;    \nsag_depth = 0.3;   \nxi4       = 100;   "
"\n                 \nq_en4     = 0;     \n\ngrid_seq = enable_2 + enable_3 + "
"enable_4;   \n\nif enable_1\n    T_sim = 1.0;\nelseif enable_2\n    T_sim = 2"
".3;\nelseif enable_3\n    T_sim = 8.0;\nelse\n    T_sim = 5.5 + phase_en*1.5;"
"\nend\n\n%% ---- Ratings and bases ------------------------------------------"
"------\nSnom = 100e6;\nVdc  = 500e3;\nfsw  = 12.5e3;\nfg   = 50;\nwg   = 2*pi"
"*fg;\n\nVbaseRMS    = 110e3;\nVbasePeak   = VbaseRMS*sqrt(2);\nVbaseFNPeak = "
"VbaseRMS*sqrt(2)/sqrt(3);\nIbaseRMS    = Snom/(sqrt(3)*VbaseRMS);\nIbasePeak "
"  = IbaseRMS*sqrt(2);\nZbase       = VbaseRMS^2/Snom;\n\nKv_out = VbaseFNPeak"
"/sqrt(2);   % pu state -> volts; the /sqrt(2) is because vc is RMS-normalized"
"\nInorm  = IbasePeak;             % current error in A -> pu\nKgamma = 2/3;  "
"                 \nKpu    = 1/Snom;                % W, VAr -> pu, for the sc"
"opes\n\n%% ---- Grid --------------------------------------------------------"
"-----\nXR  = 10;\nSCR = 3;\nif enable_4\n    SCR = 3;  \nend\nRg = VbaseRMS^2"
"/(SCR*Snom*sqrt(1+XR^2));\nLg = XR*Rg/(2*pi*fg);\n\n%% ---- LCL filter ------"
"-------------------------------------------------\nLF1 = 53.33e-3;\nLF2 = 5.3"
"3e-3;\nCF  = 1.2015e-6;\nRd  = 13;    \nRi  = 0.5;\nfr  = sqrt((LF1+LF2)/(CF*"
"LF1*LF2))/(2*pi);\n\n%% ---- Loads ------------------------------------------"
"------------------\nPload1 = 30e6;\nRload1 = VbaseRMS^2/Pload1;\nPload2 = 20e"
"6;\nRload2 = VbaseRMS^2/Pload2;\n\n%% ---- dVOC -----------------------------"
"--------------------------------\nki   = 15;\nxi   = 10;  \nVref = 1;\nkv   ="
" 1;\nCosc = 1;\nLosc = 1/wg^2;\neps  = sqrt(Losc/Cosc);\nvc0  = 1e-3;\n\nphi "
"= pi/2;   \n\nif enable_4\n    xi = xi4;\nend\n\n%% ---- Virtual impedance --"
"----------------------------------------------\nRv_damp = (1-enable_1)*0.05*Z"
"base;\nLeq_res = (LF1*LF2)/(LF1+LF2);\nKad     = (1-enable_1)*0.5*sqrt(Leq_re"
"s/CF);\n\n%% ---- P feedforward ---------------------------------------------"
"-------\npff_en  = 1;\nRff     = 3.8;   % trimmed on measured data; Rv_damp+R"
"i = 6.55 overcompensated by 1.7x\nKff     = pff_en*1.5*Rff;\ntau_pff = 0.05;"
"\n\n%% ---- Q to voltage loop -----------------------------------------------"
"-\nq_en = 1;\nKqv  = 5e-7;\nKqp  = Kqv/(2*xi);  \nif enable_4\n    q_en = q_e"
"n4;\nend\n\n%% ---- Pre-synchronization -------------------------------------"
"---------\nksync_gain   = 2;\nKsync        = ksync_gain*Inorm/VbaseFNPeak;\nt"
"au_presync2 = 0.05;\n\n%% ---- Timeline -------------------------------------"
"--------------------\nt_load1on  = 0.5; \nt_presync2 = t_load1on;\nt_syncon2 "
" = 0.9;\nif enable_2 || enable_4\n    t_gridon2 = 1.5;\nelse\n    t_gridon2 ="
" 2.7;   \nend\nt_presyncoff2 = t_gridon2 + 0.15;  \nt_qon         = t_gridon2"
" + 0.1;\n\nPstar_cmd  = 29e6;  \ntau_smooth = 0.05;\n\n%% ---- Scenario 3 ste"
"ps -------------------------------------------------\nPstar_step3 = 35e6;\nQs"
"tar_step3 = 5e6;\nt_Pstep3a = 3.7;\nt_Qstep3a = 4.7;\nt_Pstep3b = 5.7;\nt_Qst"
"ep3b = 6.7;\n\n%% ---- Scenario 4 disturbances ------------------------------"
"------------\nt_sag   = 2.5;\ndur_sag = 0.4;\nV_sag   = 1 - enable_4*sag_en*s"
"ag_depth;\n\nt_freq  = 4.0;\ndf_grid = -0.2*enable_4*freq_en;   \n\nt_phase  "
" = 5.2;\ndur_phase = 0.4;\nph_jump   = enable_4*phase_en*10*pi/180;\n\n\nqff_"
"en   = 0;\nQff_bias = 3.85e6;\ntau_qff  = 0.01;\nKqff     = qff_en*Qff_bias;"
"\ngrid_ini = 0;\nt_en     = 0;"
  InitialState  "1"
  SystemState   ""
  JacobianComputation "2"
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
