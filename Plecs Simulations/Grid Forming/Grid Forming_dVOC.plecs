    Annotation {
      Name          "<html><body>\n<p><span style=\" font-weight:600;\">Valida"
"tes independent tracking of active and reactive power dispatch commands while"
" grid-connected.</span></p>\n<p><span style=\" font-weight:600;\">The start-u"
"p and synchronization sequence is identical to Scenario 2. From there on, P* "
"and Q* are stepped</span></p>\n<p><span style=\" font-weight:600;\">one at a "
"time so the cross-coupling between the two channels can be isolated.</span></"
"p></body></html>"
      Position      [1720, 365]
    } 
