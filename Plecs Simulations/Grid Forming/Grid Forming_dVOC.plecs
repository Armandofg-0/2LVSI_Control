        Component {
          Type          Subsystem
          Name          "Step Gen. - Volt"
          Show          on
          Position      [290, 305]
          Direction     up
          Flipped       off
          LabelPosition north
          Frame         [-30, -20; 30, 20]
          SampleTime    "-1"
          CodeGenDiscretizationMethod "2"
          CodeGenTarget "Generic"
          MaskDisplayLang "2"
          MaskIconFrame on
          MaskIconOpaque off
          MaskIconRotates on
          MaskInit      "% --- Normalize N as integer >= 0\n"
"if numel(steps_N) ~= 1 || ~isfinite(steps_N)\n"
"  plecs('error','Number of steps (steps_N) must be a finite scalar.'); return"
";\n"
"end\n"
"steps_N = round(steps_N);\n"
"if steps_N < 0\n"
"  plecs('error','Number of steps (steps_N) must be >= 0.'); return;\n"
"end\n"
"\n"
"% --- Ensure row shape\n"
"steps_ti   = steps_ti(:).';\n"
"steps_len  = steps_len(:).';\n"
"steps_size = steps_size(:).';\n"
"\n"
"% --- Length checks\n"
"if numel(steps_ti) ~= steps_N\n"
"  plecs('error', sprintf('Start times (steps_ti) must have length exactly ste"
"ps_N (%d).', steps_N)); return;\n"
"end\n"
"\n"
"% Durations and amplitudes may be scalars: expand to N\n"
"if numel(steps_len) == 1\n"
"  steps_len = repmat(steps_len, 1, steps_N);\n"
"end\n"
"if numel(steps_size) == 1\n"
"  steps_size = repmat(steps_size, 1, steps_N);\n"
"end\n"
"\n"
"% Now they must match N\n"
"if numel(steps_len) ~= steps_N\n"
"  plecs('error', sprintf('Durations (steps_len) must be a scalar or have leng"
"th steps_N (%d).', steps_N)); return;\n"
"end\n"
"if numel(steps_size) ~= steps_N\n"
"  plecs('error', sprintf('Amplitudes (steps_size) must be a scalar or have le"
"ngth steps_N (%d).', steps_N)); return;\n"
"end\n"
"\n"
"% --- Value checks\n"
"if any(~isfinite(steps_ti))\n"
"  plecs('error','Start times (steps_ti) contain non-finite values.'); return;"
"\n"
"end\n"
"if any(~isfinite(steps_len))\n"
"  plecs('error','Durations (steps_len) contain non-finite values.'); return;"
"\n"
"end\n"
"if any(steps_len < 0)\n"
"  plecs('error','Durations (steps_len) must be >= 0 for all steps.'); return;"
"\n"
"end\n"
"\n"
"% Start times strictly ascending\n"
"if any(diff(steps_ti) <= 0)\n"
"  plecs('error','Start times (steps_ti) must be strictly ascending.'); return"
";\n"
"end\n"
"\n"
"% --- Build end times\n"
"steps_tf = steps_ti + steps_len;\n"
"\n"
"% Extra guard (should hold because steps_len >= 0)\n"
"if any(steps_tf < steps_ti)\n"
"  plecs('error','Found end time < start time. Check Durations (steps_len).');"
" return;\n"
"end\n"
          Parameter {
            Variable      "steps_mode"
            Prompt        "Mode"
            Type          FixedText
            PossibleValues {"Add to input" = 0, "Multiply input" = 1}
            Value         "1"
            Show          off
            Tunable       off
            TabName       ""
          }
          Parameter {
            Variable      "steps_N"
            Prompt        "Number of steps"
            Type          FreeText
            Value         "1"
            Show          off
            Tunable       off
            TabName       ""
          }
          Parameter {
            Variable      "steps_ti"
            Prompt        "Step start time (s)"
            Type          FreeText
            Value         "[t_sag]"
            Show          off
            Tunable       off
            TabName       ""
          }
          Parameter {
            Variable      "steps_len"
            Prompt        "Step length (s)"
            Type          FreeText
            Value         "[dur_sag]"
            Show          off
            Tunable       off
            TabName       ""
          }
          Parameter {
            Variable      "steps_size"
            Prompt        "Step size"
            Type          FreeText
            Value         "[V_sag]"
            Show          off
            Tunable       off
            TabName       ""
          }
          Terminal {
            Type          Input
            Position      [-30, 0]
            Direction     left
          }
          Terminal {
            Type          Input
            Position      [0, 20]
            Direction     down
          }
          Terminal {
            Type          Output
            Position      [34, 0]
            Direction     right
